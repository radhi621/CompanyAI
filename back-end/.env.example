NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/medical
CORS_ORIGIN=http://localhost:3000
# Optional: comma-separated DNS servers if your resolver cannot look up MongoDB Atlas SRV records
DNS_SERVERS=
APP_TIMEZONE=Africa/Casablanca
DEFAULT_APPOINTMENT_DURATION_MINUTES=45
MAX_APPOINTMENT_DURATION_MINUTES=720
LLM_RETRIES_PER_PROVIDER=2
LLM_RETRY_BASE_DELAY_MS=250
AGENT_IDEMPOTENCY_TTL_MINUTES=1440
# Per-user limits on the AI routes, which share one Gemini/Groq quota
AGENT_RATE_LIMIT_PER_MINUTE=20
AI_RECORD_RATE_LIMIT_PER_HOUR=60

JWT_ACCESS_SECRET=replace_with_long_secure_access_secret
JWT_REFRESH_SECRET=replace_with_long_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BOOTSTRAP_ADMIN_KEY=replace_with_secure_bootstrap_key

GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

QDRANT_URL=http://localhost:6333
# Only needed for a remote/cloud Qdrant; the local Docker one has no key.
QDRANT_API_KEY=
QDRANT_COLLECTION=medical_records
QDRANT_VECTOR_SIZE=768
